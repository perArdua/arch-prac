# OpenSearch + analysis-nori — 엔진 라운드의 nori(형태소 분석기) 대조군.
#
# 🔴 태그가 아니라 다이제스트로 고정한다(G11). 로컬의 `opensearchproject/opensearch:2.3.0`은
#    다른 이미지다 — 섞지 마라(F21).
# 이 다이제스트의 OpenSearch 버전은 2.19.6이다(이미지 라벨 `org.label-schema.version`과
# 기동 뒤 `GET /`의 `version.number`로 둘 다 확인한다 — README 참고).
FROM opensearchproject/opensearch@sha256:8690b204fe914c60ca76d451ac73bc0481e034d32d3779944c8caca56a2b003f

# nori는 기본 탑재가 아니다. 이름으로 설치하면 `opensearch-plugin`이 **엔진과 같은 버전**의
# 공식 아티팩트를 받는다:
#   https://artifacts.opensearch.org/releases/plugins/analysis-nori/2.19.6/analysis-nori-2.19.6.zip
#   (7,759,782 바이트 · sha512 4946e5d1…ce54497 — 설치기가 .sha512와 서명을 스스로 검증한다)
# 🔴 사용자 사전은 넣지 않는다 — 캐릭터 이름을 넣으면 답을 넣는 것이다.
RUN /usr/share/opensearch/bin/opensearch-plugin install --batch analysis-nori
